<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/rankoffline_dark"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/rankoffline_dark"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.RankOffline">
        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <activity-alias
            android:name=".MainActivityDark"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/rankoffline_dark"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/rankoffline_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityBlue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/rankoffline_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/rankoffline_blue"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/rankoffline_red"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/rankoffline_red"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityGreen"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/rankoffline_green"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/rankoffline_green"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityYellow"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/rankoffline_yellow"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/rankoffline_yellow"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
