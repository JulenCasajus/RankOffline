<string name="category_movie_writing_description">Trama, temi, dialoghi, costruzione narrativa e risoluzione.</string><string name="category_movie_characters_description">Scrittura dei personaggi, sviluppo, dinamiche e fascino.</string><string name="category_movie_direction_description">Messa in scena, interpretazioni, tono, scelta delle inquadrature ed esecuzione registica.</string><string name="category_movie_visuals_description">Fotografia, scenografia, effetti, illuminazione e identità visiva.</string><string name="category_editing_description">Montaggio, ritmo, transizioni, struttura e uso della durata.</string><string name="category_staging_immersion_description">Scelte di casting, interpretazioni, messa in scena, regia, impatto emotivo e capacità del film di coinvolgere e immergere lo spettatore.</string><string name="category_movie_audio_description">Colonna sonora, effetti sonori e integrazione audiovisiva.</string>
