<string name="category_manga_writing_description">Argumentua, gaiak, erritmoa, egitura, elkarrizketak, hasiera eta amaiera.</string><string name="category_manga_characters_description">Pertsonaia nagusiak eta bigarren mailakoak, garapena, sakontasuna, karisma eta dinamikak.</string><string name="category_art_description">Marrazkiaren kalitatea, arte-estiloa, pertsonaien diseinua, atzealdeak eta nortasun bisuala.</string><string name="category_paneling_description">Orrialde-konposizioa, bineten fluxua, argitasun bisuala eta diseinuaren bidezko narrazioa.</string><string name="category_manga_worldbuilding_description">Kokalekua, munduaren historia, barne-arauak, sistemak eta leku-sentsazioa.</string>
<string name="category_book_writing_description">Argumentua, gaiak, ideiak, elkarrizketak, narrazio-eraikuntza eta amaiera.</string><string name="category_book_characters_description">Pertsonaia nagusiak eta bigarren mailakoak, garapena, sakontasuna eta harremanak.</string><string name="category_prose_description">Hizkuntza, ahotsa, irakurgarritasuna, iruditeria eta estiloaren gauzatzea.</string><string name="category_book_worldbuilding_description">Kokalekua, munduaren historia, barne-koherentzia eta leku-sentsazioa, dagokionean.</string><string name="category_structure_description">Narrazio-erritmoa, kapitulu edo atalen egitura, aurrerapena eta antolaketa.</string>
<string name="category_series_writing_description">Argumentua, gaiak, elkarrizketak, erritmoa, denboraldi-egitura eta narrazioaren emaitza.</string><string name="category_series_characters_description">Pertsonaia nagusiak eta bigarren mailakoak, garapena, sakontasuna, karisma eta dinamikak.</string><string name="category_series_direction_description">Eszenaratzea, plano-aukeraketa, interpretazioak, tonua eta ikus-entzunezko zuzendaritza orokorra.</string><string name="category_series_visuals_description">Zinematografia, ekoizpen-diseinua, efektuak, argiztapena eta gauzatze bisuala.</string><string name="category_series_worldbuilding_description">Kokalekua, munduaren historia, barne-arauak eta jarraitutasuna, dagokionean.</string><string name="category_series_audio_description">Musika, soinu-diseinua, nahasketa eta audioaren erabilera.</string>
<string name="category_movie_writing_description">Argumentua, gaiak, elkarrizketak, narrazio-eraikuntza eta ebazpena.</string><string name="category_movie_characters_description">Pertsonaien idazketa, interpretazioak, garapena eta dinamikak.</string><string name="category_movie_direction_description">Eszenaratzea, interpretazioak, tonua, plano-aukeraketa eta zuzendaritzaren gauzatzea.</string><string name="category_movie_visuals_description">Zinematografia, ekoizpen-diseinua, efektuak, argiztapena eta nortasun bisuala.</string><string name="category_editing_description">Muntaia, erritmoa, eszena-trantsizioak, egitura eta iraupenaren erabilera.</string><string name="category_movie_audio_description">Soinu-banda, musika, soinu-diseinua, nahasketa eta ikus-entzunezko integrazioa.</string>
