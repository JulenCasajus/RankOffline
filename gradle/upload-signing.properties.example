RANKOFFLINE_UPLOAD_STORE_PASSWORD=change-me
RANKOFFLINE_UPLOAD_KEY_ALIAS=rankoffline-upload
RANKOFFLINE_UPLOAD_KEY_PASSWORD=change-me
